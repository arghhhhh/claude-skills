{
  "name": "github-cli",
  "description": "GitHub CLI (gh) — issues, pull requests, repos, CI checks, releases, and API access.",
  "version": "0.3.0",
  "update_policy": "check",
  "upstream": {
    "gh": {
      "type": "winget",
      "id": "GitHub.cli",
      "pin": "2.92.0",
      "match": "minimum",
      "note": "winget installs exactly the pin; brew/apt install their current version. The check accepts the pin or newer so it never forces a downgrade."
    }
  },
  "prerequisites": [],
  "install": {
    "check": "v=$(gh --version 2>/dev/null | head -1 | awk '{print $3}') && [ -n \"$v\" ] && [ \"$(printf '%s\\n' '{{PIN:gh}}' \"$v\" | sort -V | head -1)\" = '{{PIN:gh}}' ]",
    "methods": [
      {
        "name": "brew",
        "platforms": ["macos", "linux"],
        "check": "brew --version",
        "command": "brew install gh"
      },
      {
        "name": "winget",
        "platforms": ["windows"],
        "check": "winget --version",
        "command": "winget install --id GitHub.cli --version {{PIN:gh}} -e --source winget --accept-source-agreements --accept-package-agreements --silent"
      },
      {
        "name": "manual",
        "platforms": ["macos", "linux", "windows"],
        "url": "https://cli.github.com/"
      }
    ]
  },
  "test": {
    "command": "gh --version",
    "expect_success": true
  },
  "integration_test": {
    "command": "gh auth status",
    "expect_success": true,
    "description": "gh must be authenticated — run 'gh auth login' if not"
  },
  "skills": [
    "github-cli"
  ],
  "agents": []
}
