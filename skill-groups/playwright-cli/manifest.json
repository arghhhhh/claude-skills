{
  "name": "playwright-cli",
  "description": "Browser automation via CLI — navigate, click, fill, snapshot, screenshot, test, and debug web pages.",
  "version": "0.3.0",
  "upstream": {
    "playwright-cli": {
      "type": "npm",
      "package": "@playwright/cli",
      "pin": "0.1.22"
    }
  },
  "update_policy": "check",
  "prerequisites": [
    {
      "name": "node",
      "check": "node --version",
      "install_hint": "Install Node.js 18+ from https://nodejs.org/",
      "required": true,
      "note": "Node.js 18 or newer required"
    }
  ],
  "install": {
    "check": "playwright-cli --version 2>/dev/null | grep -qx {{PIN:playwright-cli}}",
    "methods": [
      {
        "name": "npm",
        "platforms": ["macos", "linux", "windows"],
        "check": "npm --version",
        "command": "npm install -g @playwright/cli@{{PIN:playwright-cli}} && playwright-cli install-browser chromium"
      }
    ]
  },
  "test": {
    "command": "playwright-cli --version",
    "expect_success": true
  },
  "integration_test": {
    "command": "playwright-cli open https://example.com && playwright-cli snapshot && playwright-cli close",
    "expect_success": true,
    "description": "Opens a browser, takes a snapshot, and closes — requires a display or headless support"
  },
  "skills": [
    "playwright-cli"
  ],
  "agents": []
}
